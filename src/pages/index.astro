---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
---

<BaseLayout
  activePage="home"
  title="Uganda Tours & Africa Safaris | Estnak Travel"
  description="Plan Uganda tours, gorilla trekking, East Africa safaris and global holidays with Estnak Tours and Travel, a Kampala-based travel agency."
  keywords="Uganda tours, Uganda safaris, Kampala travel agency, East Africa tours, gorilla trekking, Zanzibar holidays, Serengeti safari, Dubai packages, international tour packages"
  canonical="https://www.estnaktoursandtravel.com/"
  ogImage="https://www.estnaktoursandtravel.com/assets/img/optimized/hero-safari.webp"
  ogImageAlt="Safari vehicle crossing golden African grassland at sunset"
  ogImageWidth={1920}
  ogImageHeight={1284}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/assets/img/optimized/hero-safari-960.webp"
    imagesrcset="/assets/img/optimized/hero-safari-960.webp 960w, /assets/img/optimized/hero-safari-1600.webp 1600w, /assets/img/optimized/hero-safari.webp 1920w"
    imagesizes="100vw"
    fetchpriority="high"
  />
  <main id="main">
<section class="relative isolate flex min-h-[720px] items-center overflow-hidden pb-32 pt-16 sm:min-h-[780px] lg:min-h-[820px]" aria-labelledby="hero-heading">
      <img src="assets/img/optimized/hero-safari-960.webp" srcset="assets/img/optimized/hero-safari-960.webp 960w, assets/img/optimized/hero-safari-1600.webp 1600w, assets/img/optimized/hero-safari.webp 1920w" sizes="100vw" alt="Safari vehicle crossing golden African grassland at sunset" width="1920" height="1280" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-center" />
      <div class="absolute inset-0 -z-10 bg-linear-to-b from-royal-950/85 via-royal-950/50 to-royal-950/90"></div>
      <div class="absolute inset-0 -z-10 bg-linear-to-r from-royal-950/60 via-transparent to-royal-950/25"></div>

      <div class="container-x relative">
        <div class="mx-auto max-w-5xl text-center">
          <p class="hero-rise hero-rise-1 inline-flex items-center gap-2 rounded-full border border-white/25 bg-white/10 px-4 py-2 text-[11px] font-semibold uppercase tracking-[0.18em] text-white/90 backdrop-blur">
            <span class="h-1.5 w-1.5 rounded-full bg-jade-400"></span>
            Kampala-based travel experts
          </p>
          <h1 id="hero-heading" class="hero-rise hero-rise-2 mt-6 font-display text-[2.55rem] font-semibold leading-[1.04] tracking-[-0.035em] text-white sm:text-6xl lg:text-[4.55rem]">
            Explore Uganda, Africa &amp; The World <span class="text-jade-300">with Estnak tours and travel</span>
          </h1>
          <p class="hero-rise hero-rise-3 mx-auto mt-6 max-w-2xl text-base leading-relaxed text-white/80 sm:text-lg">
            Gorilla trekking, safaris, flights and tailor-made holidays — planned in Kampala.
          </p>

          <div class="hero-rise hero-rise-3 mt-6 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs font-medium text-white/85">
            <span class="inline-flex items-center gap-2"><Icon name="compass" class="h-4 w-4 text-jade-300" aria-hidden="true" />Local knowledge</span>
            <span class="inline-flex items-center gap-2"><Icon name="leaf" class="h-4 w-4 text-jade-300" aria-hidden="true" />Responsible travel</span>
            <span class="inline-flex items-center gap-2"><Icon name="headphones" class="h-4 w-4 text-jade-300" aria-hidden="true" />Personal support</span>
          </div>

          <form id="hero-search" class="hero-rise hero-rise-4 mx-auto mt-8 max-w-5xl rounded-[26px] bg-white p-2 text-left shadow-2xl shadow-black/25" role="search" aria-label="Search destinations and travel services">
            <div class="grid gap-1 lg:grid-cols-[1.65fr_0.7fr_0.7fr_auto] lg:items-stretch">
              <div class="relative rounded-2xl px-4 py-2.5 lg:py-3">
                <label for="hero-destination" class="field-label">What are you looking for?</label>
                <div class="flex items-center gap-2">
                  <Icon name="search" class="h-4 w-4 shrink-0 text-royal-600" aria-hidden="true" />
                  <input id="hero-destination" name="destination" type="text" role="combobox" aria-expanded="false" aria-controls="hero-destination-list" aria-autocomplete="list" autocomplete="off" placeholder="Search destinations, flights, safaris, visas, or global tours..." class="w-full border-0 bg-transparent p-0 text-sm font-medium text-ink placeholder:font-normal placeholder:text-slate-500 focus:outline-none" />
                </div>
                <ul id="hero-destination-list" role="listbox" aria-label="Destination suggestions" hidden class="absolute left-0 right-0 top-[calc(100%+8px)] z-40 max-h-72 overflow-y-auto rounded-2xl border border-slate-100 bg-white p-1.5 text-left shadow-lift"></ul>
              </div>
              <div class="rounded-2xl px-4 py-2.5 lg:border-l lg:border-slate-100 lg:py-3">
                <label for="hero-month" class="field-label">When</label>
                <div class="flex items-center gap-2">
                  <Icon name="calendar-days" class="h-4 w-4 shrink-0 text-royal-600" aria-hidden="true" />
                  <select id="hero-month" name="month" class="w-full cursor-pointer appearance-none border-0 bg-transparent p-0 text-sm font-medium text-ink focus:outline-none">
                    <option value="">Any time</option>
                    <option value="Jan-Mar">Jan – Mar</option>
                    <option value="Apr-Jun">Apr – Jun</option>
                    <option value="Jul-Sep">Jul – Sep</option>
                    <option value="Oct-Dec">Oct – Dec</option>
                  </select>
                </div>
              </div>
              <div class="rounded-2xl px-4 py-2.5 lg:border-l lg:border-slate-100 lg:py-3">
                <label for="hero-travellers" class="field-label">Travellers</label>
                <div class="flex items-center gap-2">
                  <Icon name="users" class="h-4 w-4 shrink-0 text-royal-600" aria-hidden="true" />
                  <select id="hero-travellers" name="travellers" class="w-full cursor-pointer appearance-none border-0 bg-transparent p-0 text-sm font-medium text-ink focus:outline-none">
                    <option value="1">1 traveller</option>
                    <option value="2" selected>2 travellers</option>
                    <option value="3">3 travellers</option>
                    <option value="4">4 travellers</option>
                    <option value="5-6">5 – 6 travellers</option>
                    <option value="7+">7+ travellers</option>
                  </select>
                </div>
              </div>
              <button type="submit" class="btn-primary m-1 w-[calc(100%-8px)] rounded-2xl py-3.5 lg:w-auto lg:px-6">
                <Icon name="search" class="h-4 w-4" aria-hidden="true" />
                Search
              </button>
            </div>
          </form>

          <div class="hero-rise hero-rise-4 mt-4 flex flex-wrap items-center justify-center gap-2 text-[11px] text-white/75">
            <span class="uppercase tracking-[0.14em]">Popular:</span>
            <button type="button" data-hero-chip="Bwindi Impenetrable Forest" class="rounded-full border border-white/25 bg-white/10 px-3 py-1.5 text-white/90 backdrop-blur transition hover:bg-white/20">Bwindi</button>
            <button type="button" data-hero-chip="Zanzibar" class="rounded-full border border-white/25 bg-white/10 px-3 py-1.5 text-white/90 backdrop-blur transition hover:bg-white/20">Zanzibar</button>
            <button type="button" data-hero-chip="Serengeti National Park" class="rounded-full border border-white/25 bg-white/10 px-3 py-1.5 text-white/90 backdrop-blur transition hover:bg-white/20">Serengeti</button>
            <button type="button" data-hero-chip="Dubai" class="rounded-full border border-white/25 bg-white/10 px-3 py-1.5 text-white/90 backdrop-blur transition hover:bg-white/20">Dubai</button>
          </div>
        </div>
      </div>
    </section>

    <div class="relative z-20 -mt-16">
      <div class="container-x">
        <dl class="reveal grid gap-px overflow-hidden rounded-3xl border border-slate-200/70 bg-slate-100 shadow-float sm:grid-cols-3">
          <div class="grid grid-cols-[auto_1fr] items-center gap-x-3 gap-y-1 bg-white px-5 py-5 text-left">
            <dt class="col-span-2 flex items-center gap-3 sm:col-span-1">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-royal-50 text-royal-700"><Icon name="map-pinned" class="h-5 w-5" aria-hidden="true" /></span>
              <span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500">Rooted in Kampala</span>
            </dt>
            <dd class="col-span-2 text-xs text-slate-500 sm:col-span-1 sm:col-start-2">Local planning, on-the-ground support</dd>
          </div>
          <div class="grid grid-cols-[auto_1fr] items-center gap-x-3 gap-y-1 bg-white px-5 py-5 text-left">
            <dt class="col-span-2 flex items-center gap-3 sm:col-span-1">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-jade-50 text-jade-700"><Icon name="route" class="h-5 w-5" aria-hidden="true" /></span>
              <span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500">Made around you</span>
            </dt>
            <dd class="col-span-2 text-xs text-slate-500 sm:col-span-1 sm:col-start-2">Private routes, your pace and budget</dd>
          </div>
          <div class="grid grid-cols-[auto_1fr] items-center gap-x-3 gap-y-1 bg-white px-5 py-5 text-left">
            <dt class="col-span-2 flex items-center gap-3 sm:col-span-1">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-royal-50 text-royal-700"><Icon name="messages-square" class="h-5 w-5" aria-hidden="true" /></span>
              <span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500">Direct support</span>
            </dt>
            <dd class="col-span-2 text-xs text-slate-500 sm:col-span-1 sm:col-start-2">Call or WhatsApp our Kampala team</dd>
          </div>
        </dl>
      </div>
    </div>

    <section class="section" aria-labelledby="travel-style-heading">
      <div class="container-x">
        <div class="mx-auto max-w-2xl text-center">
          <p class="eyebrow reveal">Start with a feeling</p>
          <h2 id="travel-style-heading" class="h2 reveal">What is your travel style?</h2>
          <p class="lede reveal mx-auto">Choose your journey. We shape the route, stays and details.</p>
        </div>
        <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          <a href="tours.html?category=safari" class="reveal group relative isolate min-h-80 overflow-hidden rounded-3xl bg-royal-950 shadow-card">
            <img src="assets/img/optimized/style-gorilla.webp" alt="Mountain gorilla resting in a lush green forest" width="900" height="1200" loading="lazy" class="absolute inset-0 -z-20 h-full w-full object-cover transition duration-700 group-hover:scale-105" />
            <div class="absolute inset-0 -z-10 bg-linear-to-t from-royal-950 via-royal-950/35 to-transparent"></div>
            <div class="flex h-full min-h-80 flex-col justify-end p-6 text-white">
              <span class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl border border-white/25 bg-white/15 backdrop-blur"><Icon name="binoculars" class="h-5 w-5" aria-hidden="true" /></span>
              <h3 class="font-display text-xl font-semibold text-white">Gorilla &amp; Wildlife Safaris</h3>
              <p class="mt-2 text-sm leading-relaxed text-white/75">Bwindi gorillas, savannah wildlife and wild landscapes.</p>
              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-jade-300">Explore safaris <Icon name="arrow-right" class="h-4 w-4" aria-hidden="true" /></span>
            </div>
          </a>
          <a href="tours.html?category=global" class="reveal group relative isolate min-h-80 overflow-hidden rounded-3xl bg-royal-950 shadow-card">
            <img src="assets/img/optimized/style-global.webp" alt="Dubai skyline with modern towers beside the waterfront" width="900" height="1200" loading="lazy" class="absolute inset-0 -z-20 h-full w-full object-cover transition duration-700 group-hover:scale-105" />
            <div class="absolute inset-0 -z-10 bg-linear-to-t from-royal-950 via-royal-950/35 to-transparent"></div>
            <div class="flex h-full min-h-80 flex-col justify-end p-6 text-white">
              <span class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl border border-white/25 bg-white/15 backdrop-blur"><Icon name="plane" class="h-5 w-5" aria-hidden="true" /></span>
              <h3 class="font-display text-xl font-semibold text-white">International Holiday Packages</h3>
              <p class="mt-2 text-sm leading-relaxed text-white/75">City breaks, beach escapes and honeymoons worldwide.</p>
              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-jade-300">See global packages <Icon name="arrow-right" class="h-4 w-4" aria-hidden="true" /></span>
            </div>
          </a>
          <a href="destinations.html#tour-starter" class="reveal group relative isolate min-h-80 overflow-hidden rounded-3xl bg-royal-950 shadow-card">
            <img src="assets/img/optimized/style-cultural.webp" alt="Busy open-air marketplace with colourful stalls and traders" width="900" height="1200" loading="lazy" class="absolute inset-0 -z-20 h-full w-full object-cover transition duration-700 group-hover:scale-105" />
            <div class="absolute inset-0 -z-10 bg-linear-to-t from-royal-950 via-royal-950/35 to-transparent"></div>
            <div class="flex h-full min-h-80 flex-col justify-end p-6 text-white">
              <span class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl border border-white/25 bg-white/15 backdrop-blur"><Icon name="landmark" class="h-5 w-5" aria-hidden="true" /></span>
              <h3 class="font-display text-xl font-semibold text-white">Cultural &amp; Excursion Tours</h3>
              <p class="mt-2 text-sm leading-relaxed text-white/75">Markets, museums, local food and untold stories.</p>
              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-jade-300">Discover experiences <Icon name="arrow-right" class="h-4 w-4" aria-hidden="true" /></span>
            </div>
          </a>
          <a href="tours.html?category=adventure" class="reveal group relative isolate min-h-80 overflow-hidden rounded-3xl bg-royal-950 shadow-card">
            <img src="assets/img/optimized/style-adventure.webp" alt="Dramatic mountain peaks beneath an open sky" width="900" height="1200" loading="lazy" class="absolute inset-0 -z-20 h-full w-full object-cover transition duration-700 group-hover:scale-105" />
            <div class="absolute inset-0 -z-10 bg-linear-to-t from-royal-950 via-royal-950/35 to-transparent"></div>
            <div class="flex h-full min-h-80 flex-col justify-end p-6 text-white">
              <span class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl border border-white/25 bg-white/15 backdrop-blur"><Icon name="mountain" class="h-5 w-5" aria-hidden="true" /></span>
              <h3 class="font-display text-xl font-semibold text-white">Adventure &amp; City Tours</h3>
              <p class="mt-2 text-sm leading-relaxed text-white/75">Active days, city walks and urban discovery.</p>
              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-jade-300">Find your adventure <Icon name="arrow-right" class="h-4 w-4" aria-hidden="true" /></span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <section class="section bg-mist" aria-labelledby="services-heading">
      <div class="container-x">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          <div class="reveal max-w-2xl">
            <p class="eyebrow">More than a safari</p>
            <h2 id="services-heading" class="h2">Our Travel &amp; Concierge Services</h2>
            <p class="lede">One team for every detail, from flight to final transfer.</p>
          </div>
          <a href="destinations.html#tour-starter" class="link-arrow reveal shrink-0">View all services <Icon name="arrow-right" class="h-4 w-4" aria-hidden="true" /></a>
        </div>

        <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          <article class="reveal card flex flex-col p-6">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-royal-50 text-royal-700"><Icon name="plane-takeoff" class="h-6 w-6" aria-hidden="true" /></span>
            <h3 class="mt-5 font-display text-lg font-semibold">Flight &amp; Air Ticket Booking</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-500">Domestic and international flights, arranged around your route.</p>
            <a href="https://wa.me/256769532299?text=Hello%20Estnak%2C%20please%20help%20with%20a%20flight%20booking." target="_blank" rel="noopener" data-whatsapp="Hello Estnak Tours and Travel, please help me book a domestic or international flight." class="link-arrow mt-5">Ask about flights <Icon name="arrow-up-right" class="h-4 w-4" aria-hidden="true" /></a>
          </article>
          <article class="reveal card flex flex-col p-6">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-jade-50 text-jade-700"><Icon name="file-check-2" class="h-6 w-6" aria-hidden="true" /></span>
            <h3 class="mt-5 font-display text-lg font-semibold">Visa Processing &amp; Documentation Assistance</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-500">Clear guidance on requirements, documents and timing.</p>
            <a href="https://wa.me/256769532299?text=Hello%20Estnak%2C%20I%20need%20visa%20and%20documentation%20assistance." target="_blank" rel="noopener" data-whatsapp="Hello Estnak Tours and Travel, I need visa processing and documentation assistance." class="link-arrow mt-5">Ask about visas <Icon name="arrow-up-right" class="h-4 w-4" aria-hidden="true" /></a>
          </article>
          <article class="reveal card flex flex-col p-6">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-royal-50 text-royal-700"><Icon name="compass" class="h-6 w-6" aria-hidden="true" /></span>
            <h3 class="mt-5 font-display text-lg font-semibold">Local &amp; International Tour Operations &amp; Safaris</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-500">Tailor-made safaris and journeys across Africa and beyond.</p>
            <a href="https://wa.me/256769532299?text=Hello%20Estnak%2C%20please%20help%20me%20plan%20a%20tour%20or%20safari." target="_blank" rel="noopener" data-whatsapp="Hello Estnak Tours and Travel, please help me plan a local or international tour and safari." class="link-arrow mt-5">Plan a tour <Icon name="arrow-up-right" class="h-4 w-4" aria-hidden="true" /></a>
          </article>
          <article class="reveal card flex flex-col p-6">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-jade-50 text-jade-700"><Icon name="car-front" class="h-6 w-6" aria-hidden="true" /></span>
            <h3 class="mt-5 font-display text-lg font-semibold">Transport &amp; Vehicle Rentals</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-500">Airport transfers, safari vehicles and trusted drivers.</p>
            <a href="https://wa.me/256769532299?text=Hello%20Estnak%2C%20I%20need%20transport%20or%20a%20vehicle%20rental." target="_blank" rel="noopener" data-whatsapp="Hello Estnak Tours and Travel, I need transport, an airport transfer or a vehicle rental." class="link-arrow mt-5">Ask about transport <Icon name="arrow-up-right" class="h-4 w-4" aria-hidden="true" /></a>
          </article>
          <article class="reveal card flex flex-col p-6">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-royal-50 text-royal-700"><Icon name="hotel" class="h-6 w-6" aria-hidden="true" /></span>
            <h3 class="mt-5 font-display text-lg font-semibold">Hotel &amp; Accommodation Bookings</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-500">Stays selected for your route, comfort and budget.</p>
            <a href="https://wa.me/256769532299?text=Hello%20Estnak%2C%20please%20help%20with%20accommodation%20bookings." target="_blank" rel="noopener" data-whatsapp="Hello Estnak Tours and Travel, please help me find and book accommodation." class="link-arrow mt-5">Find a stay <Icon name="arrow-up-right" class="h-4 w-4" aria-hidden="true" /></a>
          </article>
          <article class="reveal card flex flex-col p-6">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-jade-50 text-jade-700"><Icon name="briefcase-business" class="h-6 w-6" aria-hidden="true" /></span>
            <h3 class="mt-5 font-display text-lg font-semibold">Corporate Travel &amp; MICE Management</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-500">Business travel, conferences and group logistics.</p>
            <a href="https://wa.me/256769532299?text=Hello%20Estnak%2C%20I%20need%20corporate%20travel%20or%20MICE%20support." target="_blank" rel="noopener" data-whatsapp="Hello Estnak Tours and Travel, I need corporate travel or MICE management support." class="link-arrow mt-5">Discuss group travel <Icon name="arrow-up-right" class="h-4 w-4" aria-hidden="true" /></a>
          </article>
          <article class="reveal card flex flex-col p-6">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-royal-50 text-royal-700"><Icon name="graduation-cap" class="h-6 w-6" aria-hidden="true" /></span>
            <h3 class="mt-5 font-display text-lg font-semibold">Relocation &amp; Educational Travel Support</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-500">Practical support for relocations, study travel and groups.</p>
            <a href="https://wa.me/256769532299?text=Hello%20Estnak%2C%20I%20need%20relocation%20or%20educational%20travel%20support." target="_blank" rel="noopener" data-whatsapp="Hello Estnak Tours and Travel, I need relocation or educational travel support." class="link-arrow mt-5">Ask for support <Icon name="arrow-up-right" class="h-4 w-4" aria-hidden="true" /></a>
          </article>
          <article class="reveal card flex flex-col p-6">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-jade-50 text-jade-700"><Icon name="shield-check" class="h-6 w-6" aria-hidden="true" /></span>
            <h3 class="mt-5 font-display text-lg font-semibold">Travel Insurance &amp; Digital Booking Support</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-500">Cover guidance and help with digital bookings.</p>
            <a href="https://wa.me/256769532299?text=Hello%20Estnak%2C%20please%20help%20with%20travel%20insurance%20or%20online%20booking%20support." target="_blank" rel="noopener" data-whatsapp="Hello Estnak Tours and Travel, please help with travel insurance or digital booking support." class="link-arrow mt-5">Get practical help <Icon name="arrow-up-right" class="h-4 w-4" aria-hidden="true" /></a>
          </article>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="recommended-heading">
      <div class="container-x">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
          <div class="reveal max-w-2xl">
            <p class="eyebrow">Journeys to start with</p>
            <h2 id="recommended-heading" class="h2">Recommended Tours</h2>
            <p class="lede">Signature journeys, tailored to your dates and pace.</p>
          </div>
          <a href="tours.html" class="link-arrow reveal shrink-0">Browse all tours <Icon name="arrow-right" class="h-4 w-4" aria-hidden="true" /></a>
        </div>

        <div class="mt-10 grid gap-6 lg:grid-cols-3">
          <article class="tour-card reveal">
