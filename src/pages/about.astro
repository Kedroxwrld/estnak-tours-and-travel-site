---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
---

<BaseLayout
  activePage="about"
  title="About Estnak Tours and Travel | Kampala Team"
  description="Meet the Kampala team at Estnak Tours and Travel, supporting Uganda tours, safaris, travel bookings and local or international trip planning."
  keywords="Estnak Tours and Travel, Kampala travel agency, Uganda tour operator, East Africa travel team, responsible travel Uganda"
  canonical="https://www.estnaktoursandtravel.com/about.html"
  ogImage="https://www.estnaktoursandtravel.com/assets/img/optimized/about-safari.webp"
  ogImageAlt="A safari vehicle in golden grassland beneath a warm sunset sky"
  ogImageWidth={1400}
  ogImageHeight={1100}
  themeColor="#0D2B3E"
>
  <main id="main">
<section class="relative isolate overflow-hidden bg-royal-950 py-16 text-white sm:py-20 lg:py-24" aria-labelledby="page-heading">
      <img src="assets/img/optimized/about-safari.webp" alt="A safari vehicle in golden grassland beneath a warm sunset sky" width="1400" height="1100" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-center opacity-55" />
      <div class="absolute inset-0 -z-10 bg-linear-to-r from-royal-950 via-royal-950/85 to-royal-950/30"></div>
      <div class="absolute inset-0 -z-10 bg-linear-to-t from-royal-950/85 via-transparent to-royal-950/40"></div>
      <div class="container-x relative">
        <nav aria-label="Breadcrumb" class="text-[11px] font-medium uppercase tracking-[0.16em] text-white/70">
          <ol class="flex flex-wrap items-center gap-2">
            <li><a href="index.html" class="transition hover:text-white">Home</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page" class="text-white/85">About us</li>
          </ol>
        </nav>
        <div class="mt-6 max-w-3xl">
          <p class="hero-rise hero-rise-1 eyebrow eyebrow-light">About Estnak</p>
          <h1 id="page-heading" class="hero-rise hero-rise-2 mt-4 font-display text-4xl font-semibold leading-[1.05] tracking-tight text-white sm:text-5xl lg:text-6xl">Meet the Kampala team behind your journey.</h1>
          <p class="hero-rise hero-rise-3 mt-5 max-w-2xl text-base leading-relaxed text-white/75 sm:text-lg">Thoughtful travel planning, bookings and ground arrangements across Uganda, East Africa and beyond.</p>
          <div class="hero-rise hero-rise-4 mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="#team" class="btn-primary">Meet the team
              <Icon name="users" class="h-4 w-4" aria-hidden="true" />
            </a>
            <a href="contact.html" class="btn-glass">Plan with us
              <Icon name="arrow-right" class="h-4 w-4" aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="story-heading">
      <div class="container-x grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-16">
        <div class="reveal group relative">
          <div class="overflow-hidden rounded-4xl shadow-lift">
            <img src="assets/img/optimized/tour-vehicles.webp" alt="A tour vehicle with its door open beside a thatched visitor area" width="1000" height="1200" loading="lazy" class="aspect-4/5 w-full object-cover object-center transition duration-700 ease-out group-hover:scale-105" />
          </div>
          <span class="glass-badge absolute bottom-4 left-4">
            <Icon name="map-pinned" class="h-4 w-4 text-royal-700" aria-hidden="true" />
            Kampala, Uganda
          </span>
        </div>

        <div class="reveal">
          <p class="eyebrow">Our purpose</p>
          <h2 id="story-heading" class="h2">Travel support built around your plans.</h2>
          <p class="mt-5 text-base leading-relaxed text-slate-600">Kampala-based Estnak Tours and Travel coordinates tours, ticketing, accommodation and transport for local and international trips.</p>
          <p class="mt-4 text-base leading-relaxed text-slate-600">Our objectives shape the service we provide:</p>
          <ul class="mt-5 space-y-4">
            <li class="flex items-start gap-3">
              <Icon name="circle-check" class="mt-0.5 h-5 w-5 shrink-0 text-jade-700" aria-hidden="true" />
              <p class="text-sm leading-relaxed text-slate-600">Arrange tours, excursions, safaris and sightseeing across Uganda and beyond.</p>
            </li>
            <li class="flex items-start gap-3">
              <Icon name="circle-check" class="mt-0.5 h-5 w-5 shrink-0 text-jade-700" aria-hidden="true" />
              <p class="text-sm leading-relaxed text-slate-600">Coordinate airline ticketing and hotel, lodge, resort or other accommodation bookings.</p>
            </li>
            <li class="flex items-start gap-3">
              <Icon name="circle-check" class="mt-0.5 h-5 w-5 shrink-0 text-jade-700" aria-hidden="true" />
              <p class="text-sm leading-relaxed text-slate-600">Provide transport and ground transfers for tourists, businesses and other clients.</p>
            </li>
            <li class="flex items-start gap-3">
              <Icon name="circle-check" class="mt-0.5 h-5 w-5 shrink-0 text-jade-700" aria-hidden="true" />
              <p class="text-sm leading-relaxed text-slate-600">Deliver compliant travel services locally and internationally.</p>
            </li>
          </ul>

          <div class="mt-7 rounded-2xl border border-royal-100 bg-royal-50 p-5">
            <div class="flex items-start gap-3">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white text-royal-700 shadow-card">
                <Icon name="map-pinned" class="h-5 w-5" aria-hidden="true" />
              </span>
              <address class="not-italic text-sm leading-relaxed text-slate-600">
                <span class="block font-semibold text-ink">Estnak Tours and Travel</span>
                Civic Centre, Christ The King, 217507 Kampala GPO, Kampala, Uganda
              </address>
            </div>
            <dl class="mt-5 grid gap-4 border-t border-royal-100 pt-5 sm:grid-cols-2">
              <div>
                <dt class="text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500">Phone</dt>
                <dd class="mt-1"><a href="tel:+256769532299" class="text-sm font-semibold text-royal-700 underline decoration-royal-200 underline-offset-2 hover:text-royal-800">0769 532299</a></dd>
              </div>
              <div>
                <dt class="text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500">Email</dt>
                <dd class="mt-1"><a href="mailto:estnaktoursandtravel@gmail.com" class="break-all text-sm font-semibold text-royal-700 underline decoration-royal-200 underline-offset-2 hover:text-royal-800">estnaktoursandtravel@gmail.com</a></dd>
              </div>
              <div class="sm:col-span-2">
                <dt class="text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500">Office hours</dt>
                <dd class="mt-1 text-sm text-slate-600">Mon–Sat 9:00 AM–5:00 PM EAT <span class="mx-1 text-slate-400" aria-hidden="true">·</span> Sunday closed</dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <section class="section bg-mist" aria-labelledby="values-heading">
      <div class="container-x">
        <div class="mx-auto max-w-2xl text-center">
          <p class="eyebrow reveal">What guides us</p>
          <h2 id="values-heading" class="h2 reveal">Four values at the heart of our work.</h2>
          <p class="lede reveal mx-auto">These principles shape the guidance we offer before you book.</p>
        </div>

        <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          <article class="card reveal group p-6 transition duration-500 hover:-translate-y-1.5 hover:border-royal-200 hover:shadow-lift">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-royal-50 text-royal-700 transition duration-300 group-hover:scale-110">
              <Icon name="map-pinned" class="h-5 w-5" aria-hidden="true" />
            </span>
            <h3 class="mt-4 font-display text-lg font-semibold">Local first</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-500">We choose local guides, drivers, stays and experiences rooted in place.</p>
          </article>

          <article class="card reveal group p-6 transition duration-500 hover:-translate-y-1.5 hover:border-royal-200 hover:shadow-lift">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-jade-50 text-jade-700 transition duration-300 group-hover:scale-110">
              <Icon name="receipt-text" class="h-5 w-5" aria-hidden="true" />
            </span>
            <h3 class="mt-4 font-display text-lg font-semibold">Clear pricing</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-500">We clarify inclusions, on-request arrangements and variable costs before booking.</p>
          </article>

          <article class="card reveal group p-6 transition duration-500 hover:-translate-y-1.5 hover:border-royal-200 hover:shadow-lift">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-royal-50 text-royal-700 transition duration-300 group-hover:scale-110">
              <Icon name="leaf" class="h-5 w-5" aria-hidden="true" />
            </span>
            <h3 class="mt-4 font-display text-lg font-semibold">Responsible travel</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-500">Wildlife, communities and environmental impact shape our route and supplier choices.</p>
          </article>

          <article class="card reveal group p-6 transition duration-500 hover:-translate-y-1.5 hover:border-royal-200 hover:shadow-lift">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-jade-50 text-jade-700 transition duration-300 group-hover:scale-110">
              <Icon name="headphones" class="h-5 w-5" aria-hidden="true" />
            </span>
            <h3 class="mt-4 font-display text-lg font-semibold">Personal support</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-500">Speak directly with our team about itineraries, documents, transfers and bookings.</p>
          </article>
        </div>
      </div>
    </section>

    <section id="team" class="section scroll-mt-24" aria-labelledby="team-heading">
      <div class="container-x">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
          <div class="reveal max-w-2xl">
            <p class="eyebrow">The people behind the plans</p>
            <h2 id="team-heading" class="h2">Meet your travel team.</h2>
            <p class="lede">Based in Kampala, Esther and Alex coordinate planning and ground arrangements.</p>
          </div>
          <a href="contact.html" class="link-arrow reveal shrink-0">Get in touch
            <Icon name="arrow-right" class="h-4 w-4" aria-hidden="true" />
          </a>
        </div>

        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:max-w-4xl">
          <article class="tour-card reveal group" aria-labelledby="esther-heading">
            <div class="aspect-4/5 overflow-hidden bg-white">
              <img src="assets/img/optimized/nakibule-esther.webp" alt="Nakibuule Esther, Founder and Managing Director at Estnak Tours and Travel" width="600" height="800" loading="lazy" class="h-full w-full object-cover object-top transition duration-700 ease-out group-hover:scale-105" />
            </div>
            <div class="p-5 sm:p-6">
              <h3 id="esther-heading" class="font-display text-xl font-semibold">Nakibuule Esther</h3>
              <p class="mt-1 text-[11px] font-semibold uppercase tracking-[0.14em] text-royal-700">Founder &amp; MD</p>
              <p class="mt-3 text-sm leading-relaxed text-slate-500">Leads the company, overseeing travel planning, client communication and service delivery.</p>
            </div>
          </article>

          <article class="tour-card reveal group" aria-labelledby="alex-heading">
            <div class="aspect-4/5 overflow-hidden bg-white">
              <img src="assets/img/optimized/mpata-alex.webp" alt="Mpata Alex, Safari Operations at Estnak Tours and Travel" width="600" height="800" loading="lazy" class="h-full w-full object-cover object-top transition duration-700 ease-out group-hover:scale-105" />
            </div>
            <div class="p-5 sm:p-6">
              <h3 id="alex-heading" class="font-display text-xl font-semibold">Mpata Alex</h3>
              <p class="mt-1 text-[11px] font-semibold uppercase tracking-[0.14em] text-royal-700">Safari Operations</p>
              <p class="mt-3 text-sm leading-relaxed text-slate-500">Coordinates safari transport, ground arrangements and local service partnerships.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="section bg-mist" aria-labelledby="community-heading">
      <div class="container-x grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-16">
        <div class="reveal order-2 lg:order-1">
          <p class="eyebrow">Community &amp; local partners</p>
          <h2 id="community-heading" class="h2">Travel rooted in local partnership.</h2>
          <p class="lede">We work with local service providers to arrange transport, guiding, accommodation and cultural experiences. We welcome conversations with partners who share a respectful approach to people and places.</p>
          <div class="mt-7 grid gap-4 sm:grid-cols-3">
            <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-card">
              <Icon name="users" class="h-5 w-5 text-royal-700" aria-hidden="true" />
              <h3 class="mt-3 font-display text-base font-semibold">Local providers</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-500">Guides, drivers, stays and experience hosts help shape each itinerary.</p>
            </div>
            <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-card">
              <Icon name="heart-handshake" class="h-5 w-5 text-jade-700" aria-hidden="true" />
              <h3 class="mt-3 font-display text-base font-semibold">Community &amp; culture</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-500">We look for respectful ways to include local culture and support the people who host travellers.</p>
            </div>
            <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-card">
              <Icon name="leaf" class="h-5 w-5 text-royal-700" aria-hidden="true" />
              <h3 class="mt-3 font-display text-base font-semibold">Responsible choices</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-500">We consider environmental impact and wildlife welfare when discussing routes and suppliers.</p>
            </div>
          </div>
          <a href="contact.html" class="link-arrow mt-7">Talk to us about local partnerships
            <Icon name="arrow-right" class="h-4 w-4" aria-hidden="true" />
          </a>
        </div>
        <div class="reveal group order-1 overflow-hidden rounded-4xl shadow-lift lg:order-2">
          <img src="assets/img/optimized/kampala-city.webp" alt="Travellers overlooking a busy taxi park and city skyline in Kampala" width="1200" height="900" loading="lazy" class="aspect-4/3 w-full object-cover object-center transition duration-700 ease-out group-hover:scale-105" />
        </div>
      </div>
    </section>

    <section class="section pt-0" aria-labelledby="about-cta-heading">
      <div class="container-x">
        <div class="reveal relative isolate overflow-hidden rounded-4xl bg-royal-950 px-6 py-12 text-white sm:px-10 lg:px-14 lg:py-16">
          <img src="assets/img/optimized/art-gallery.webp" alt="Travellers speaking with vendors beside a colourful art display" width="1000" height="1200" loading="lazy" class="absolute inset-0 -z-20 h-full w-full object-cover object-center opacity-30" />
          <div class="absolute inset-0 -z-10 bg-linear-to-r from-royal-950 via-royal-950/90 to-royal-950/40"></div>
          <div class="max-w-2xl">
            <p class="eyebrow eyebrow-light">Plan with our team</p>
            <h2 id="about-cta-heading" class="mt-4 font-display text-3xl font-semibold tracking-tight text-white sm:text-4xl">Let’s plan your next journey together.</h2>
            <p class="mt-4 text-base leading-relaxed text-white/75">Tell us where you would like to go, or ask about working with local partners. We’ll help you identify the next steps.</p>
            <div class="mt-7 flex flex-col gap-3 sm:flex-row">
              <a href="contact.html" class="btn-primary">Start planning
                <Icon name="arrow-right" class="h-4 w-4" aria-hidden="true" />
              </a>
              <a href="https://wa.me/256769532299?text=Hello%20Estnak%20Tours%20and%20Travel%2C%20I%27d%20like%20to%20discuss%20a%20trip%20or%20a%20local%20partnership.%20Please%20let%20me%20know%20the%20next%20steps." target="_blank" rel="noopener" class="btn-glass">Ask on WhatsApp
                <Icon name="message-circle" class="h-4 w-4" aria-hidden="true" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
