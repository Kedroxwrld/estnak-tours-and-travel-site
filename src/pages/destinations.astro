---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
---

<BaseLayout
  activePage="destinations"
  title="Uganda Travel Services & Destinations | Estnak"
  description="Explore travel services and destinations in Uganda, East Africa and worldwide with Estnak Tours and Travel in Kampala. Plan your trip with our team."
  keywords="Uganda travel services, East Africa tours, worldwide destinations, Kampala travel agency, flight booking Uganda, safari transport rentals"
  canonical="https://www.estnaktoursandtravel.com/destinations.html"
  ogImage="https://www.estnaktoursandtravel.com/assets/img/optimized/tour-zanzibar.webp"
  ogImageAlt="A lighthouse beside a white-sand beach and clear turquoise water"
  ogImageWidth={1000}
  ogImageHeight={563}
  themeColor="#0D2B3E"
>
  <main id="main">
<section class="relative isolate overflow-hidden bg-royal-950 py-16 text-white sm:py-20 lg:py-24" aria-labelledby="page-heading">
      <img src="assets/img/optimized/tour-zanzibar.webp" alt="A lighthouse beside a white-sand beach and clear turquoise water" width="1000" height="563" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-center opacity-55" />
      <div class="absolute inset-0 -z-10 bg-linear-to-r from-royal-950 via-royal-950/85 to-royal-950/35"></div>
      <div class="absolute inset-0 -z-10 bg-linear-to-t from-royal-950/80 via-transparent to-royal-950/40"></div>
      <div class="container-x relative">
        <nav aria-label="Breadcrumb" class="text-[11px] font-medium uppercase tracking-[0.16em] text-white/70">
          <ol class="flex flex-wrap items-center gap-2">
            <li><a href="index.html" class="transition hover:text-white">Home</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page" class="text-white/85">Destinations</li>
          </ol>
        </nav>
        <div class="mt-6 max-w-3xl">
          <p class="hero-rise hero-rise-1 eyebrow eyebrow-light">Travel your way</p>
          <h1 id="page-heading" class="hero-rise hero-rise-2 mt-4 font-display text-4xl font-semibold leading-[1.05] tracking-tight text-white sm:text-5xl lg:text-6xl">Travel services for Uganda, East Africa &amp; the world.</h1>
          <p class="hero-rise hero-rise-3 mt-5 max-w-2xl text-base leading-relaxed text-white/75 sm:text-lg">Seamlessly plan flights, visas, safaris, stays and transport with our Kampala team, wherever you travel.</p>
          <div class="hero-rise hero-rise-4 mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="tours.html" class="btn-primary">Browse tours
              <Icon name="arrow-right" class="h-4 w-4" aria-hidden="true" />
            </a>
            <a href="contact.html" class="btn-glass">Contact our team
              <Icon name="message-circle" class="h-4 w-4" aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="tour-starter" class="section scroll-mt-24" aria-labelledby="services-heading">
      <div class="container-x">
        <div class="reveal max-w-3xl">
          <p class="eyebrow">Plan with confidence</p>
          <h2 id="services-heading" class="h2">Our Travel &amp; Concierge Services</h2>
          <p class="lede">Choose a service to open a ready-to-send WhatsApp enquiry.</p>
        </div>

        <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          <article class="card reveal group flex flex-col p-6 transition duration-500 hover:-translate-y-1.5 hover:border-royal-200 hover:shadow-lift">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-royal-50 text-royal-700 transition duration-300 group-hover:scale-110">
              <Icon name="plane-takeoff" class="h-6 w-6" aria-hidden="true" />
            </span>
            <h3 class="mt-5 font-display text-lg font-semibold leading-snug">Flight &amp; Air Ticket Booking</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-500">Domestic and international flights arranged around your route, dates and preferences.</p>
            <a href="https://wa.me/256769532299?text=Hello%20Estnak%20Tours%20and%20Travel%2C%20I%27d%20like%20help%20booking%20a%20flight.%20Please%20share%20the%20details%20you%20need." target="_blank" rel="noopener" class="link-arrow mt-5">Ask about flights
              <Icon name="message-circle" class="h-4 w-4" aria-hidden="true" />
            </a>
          </article>

          <article class="card reveal group flex flex-col p-6 transition duration-500 hover:-translate-y-1.5 hover:border-royal-200 hover:shadow-lift">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-jade-50 text-jade-700 transition duration-300 group-hover:scale-110">
              <Icon name="file-check" class="h-6 w-6" aria-hidden="true" />
            </span>
            <h3 class="mt-5 font-display text-lg font-semibold leading-snug">Visa Processing &amp; Documentation Assistance</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-500">Clear guidance on destination requirements, supporting documents and application preparation.</p>
            <a href="https://wa.me/256769532299?text=Hello%20Estnak%20Tours%20and%20Travel%2C%20I%27d%20like%20guidance%20on%20visa%20processing%20and%20travel%20documentation.%20Please%20share%20the%20next%20steps." target="_blank" rel="noopener" class="link-arrow mt-5">Ask about documents
              <Icon name="message-circle" class="h-4 w-4" aria-hidden="true" />
            </a>
          </article>

          <article class="card reveal group flex flex-col p-6 transition duration-500 hover:-translate-y-1.5 hover:border-royal-200 hover:shadow-lift">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-royal-50 text-royal-700 transition duration-300 group-hover:scale-110">
              <Icon name="compass" class="h-6 w-6" aria-hidden="true" />
            </span>
            <h3 class="mt-5 font-display text-lg font-semibold leading-snug">Local &amp; International Tour Operations &amp; Safaris</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-500">Shape a Uganda safari, East Africa itinerary or international trip around your interests and pace.</p>
            <a href="https://wa.me/256769532299?text=Hello%20Estnak%20Tours%20and%20Travel%2C%20I%27d%20like%20to%20plan%20a%20local%20or%20international%20tour%20or%20safari.%20Please%20help%20me%20explore%20options." target="_blank" rel="noopener" class="link-arrow mt-5">Plan a tour
              <Icon name="message-circle" class="h-4 w-4" aria-hidden="true" />
            </a>
          </article>

          <article id="transport" class="card reveal group flex scroll-mt-24 flex-col p-6 transition duration-500 hover:-translate-y-1.5 hover:border-royal-200 hover:shadow-lift">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-jade-50 text-jade-700 transition duration-300 group-hover:scale-110">
              <Icon name="car-front" class="h-6 w-6" aria-hidden="true" />
            </span>
            <h3 class="mt-5 font-display text-lg font-semibold leading-snug">Transport &amp; Vehicle Rentals</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-500">Arrange airport transfers, safari transport or vehicle hire around your route, schedule and group.</p>
            <a href="https://wa.me/256769532299?text=Hello%20Estnak%20Tours%20and%20Travel%2C%20I%27d%20like%20to%20enquire%20about%20transport%20or%20a%20vehicle%20rental.%20Please%20share%20the%20available%20options." target="_blank" rel="noopener" class="link-arrow mt-5">Ask about transport
              <Icon name="message-circle" class="h-4 w-4" aria-hidden="true" />
            </a>
          </article>

          <article class="card reveal group flex flex-col p-6 transition duration-500 hover:-translate-y-1.5 hover:border-royal-200 hover:shadow-lift">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-royal-50 text-royal-700 transition duration-300 group-hover:scale-110">
              <Icon name="hotel" class="h-6 w-6" aria-hidden="true" />
            </span>
            <h3 class="mt-5 font-display text-lg font-semibold leading-snug">Hotel &amp; Accommodation Bookings</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-500">Request accommodation options suited to your itinerary, budget and preferred travel style.</p>
            <a href="https://wa.me/256769532299?text=Hello%20Estnak%20Tours%20and%20Travel%2C%20I%27d%20like%20help%20booking%20hotel%20or%20accommodation.%20Please%20share%20the%20details%20you%20need." target="_blank" rel="noopener" class="link-arrow mt-5">Ask about stays
              <Icon name="message-circle" class="h-4 w-4" aria-hidden="true" />
            </a>
          </article>

          <article class="card reveal group flex flex-col p-6 transition duration-500 hover:-translate-y-1.5 hover:border-royal-200 hover:shadow-lift">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-jade-50 text-jade-700 transition duration-300 group-hover:scale-110">
              <Icon name="briefcase-business" class="h-6 w-6" aria-hidden="true" />
            </span>
            <h3 class="mt-5 font-display text-lg font-semibold leading-snug">Corporate Travel &amp; MICE Management</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-500">Discuss travel arrangements, event logistics and ground coordination for teams and organisations.</p>
            <a href="https://wa.me/256769532299?text=Hello%20Estnak%20Tours%20and%20Travel%2C%20I%27d%20like%20support%20with%20corporate%20travel%20or%20a%20MICE%20event.%20Please%20share%20the%20information%20you%20need." target="_blank" rel="noopener" class="link-arrow mt-5">Discuss business travel
              <Icon name="message-circle" class="h-4 w-4" aria-hidden="true" />
            </a>
          </article>

          <article class="card reveal group flex flex-col p-6 transition duration-500 hover:-translate-y-1.5 hover:border-royal-200 hover:shadow-lift">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-royal-50 text-royal-700 transition duration-300 group-hover:scale-110">
              <Icon name="graduation-cap" class="h-6 w-6" aria-hidden="true" />
            </span>
            <h3 class="mt-5 font-display text-lg font-semibold leading-snug">Relocation &amp; Educational Travel Support</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-500">Ask for practical planning support with relocation travel, educational visits and related bookings.</p>
            <a href="https://wa.me/256769532299?text=Hello%20Estnak%20Tours%20and%20Travel%2C%20I%27d%20like%20support%20with%20relocation%20or%20educational%20travel.%20Please%20share%20how%20you%20can%20help." target="_blank" rel="noopener" class="link-arrow mt-5">Ask about travel support
              <Icon name="message-circle" class="h-4 w-4" aria-hidden="true" />
            </a>
          </article>

          <article class="card reveal group flex flex-col p-6 transition duration-500 hover:-translate-y-1.5 hover:border-royal-200 hover:shadow-lift">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-jade-50 text-jade-700 transition duration-300 group-hover:scale-110">
              <Icon name="shield-check" class="h-6 w-6" aria-hidden="true" />
            </span>
            <h3 class="mt-5 font-display text-lg font-semibold leading-snug">Travel Insurance &amp; Digital Booking Support</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-500">Ask about travel insurance options and get help with online reservations and digital booking steps.</p>
            <a href="https://wa.me/256769532299?text=Hello%20Estnak%20Tours%20and%20Travel%2C%20I%27d%20like%20information%20about%20travel%20insurance%20and%20digital%20booking%20support.%20Please%20share%20the%20available%20options." target="_blank" rel="noopener" class="link-arrow mt-5">Ask about insurance
              <Icon name="message-circle" class="h-4 w-4" aria-hidden="true" />
            </a>
          </article>
        </div>
      </div>
    </section>

    <section class="section bg-mist" aria-labelledby="destinations-heading">
      <div class="container-x">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          <div class="reveal max-w-2xl">
            <p class="eyebrow">Find your next place</p>
            <h2 id="destinations-heading" class="h2">Explore destinations near and far.</h2>
            <p class="lede">Start with a place that inspires you, explore matching tours, or ask us to shape a custom itinerary around your dates and interests.</p>
          </div>
          <p id="destination-count" class="reveal text-sm font-semibold text-ink" aria-live="polite">8 destinations</p>
        </div>

        <div class="reveal mt-8 flex gap-2 overflow-x-auto pb-1 no-scrollbar" role="group" aria-label="Filter destinations by region">
          <button type="button" data-region="all" class="chip is-active" aria-pressed="true">All</button>
          <button type="button" data-region="east-africa" class="chip" aria-pressed="false">East Africa</button>
          <button type="button" data-region="islands" class="chip" aria-pressed="false">Islands</button>
          <button type="button" data-region="africa" class="chip" aria-pressed="false">Africa</button>
          <button type="button" data-region="global" class="chip" aria-pressed="false">Global</button>
        </div>

        <div id="destination-grid" class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          <article id="uganda" data-destination-card data-region="east-africa" class="tour-card reveal group" aria-labelledby="uganda-heading">
            <a href="tours.html?destination=Uganda" class="relative block aspect-4/3 overflow-hidden" aria-label="View Uganda tours and travel ideas">
              <img src="assets/img/optimized/tour-uganda.webp" alt="An antelope standing in golden grassland under an open sky" width="1000" height="1500" loading="lazy" class="h-full w-full object-cover object-center transition duration-700 ease-out group-hover:scale-110" />
              <div class="absolute inset-0 bg-linear-to-t from-ink/50 via-transparent to-transparent"></div>
              <span class="glass-badge absolute left-3 top-3">East Africa</span>
              <span class="absolute bottom-3 right-3 flex h-9 w-9 items-center justify-center rounded-full border border-white/40 bg-white/15 text-white backdrop-blur transition group-hover:bg-white group-hover:text-royal-800">
                <Icon name="arrow-up-right" class="h-4 w-4" aria-hidden="true" />
              </span>
            </a>
            <div class="flex flex-1 flex-col p-5 sm:p-6">
              <h3 id="uganda-heading" class="font-display text-xl font-semibold"><a href="tours.html?destination=Uganda" class="transition hover:text-royal-700">Uganda</a></h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-500">Plan a safari, primate trek or city break with transport and accommodation arranged around your route.</p>
              <a href="tours.html?destination=Uganda" class="link-arrow mt-4">Explore Uganda
                <Icon name="arrow-right" class="h-4 w-4" aria-hidden="true" />
              </a>
            </div>
          </article>

          <article id="kenya" data-destination-card data-region="east-africa" class="tour-card reveal group" aria-labelledby="kenya-heading">
            <a href="tours.html?destination=Kenya" class="relative block aspect-4/3 overflow-hidden" aria-label="View Kenya tours and travel ideas">
              <img src="assets/img/optimized/dest-kenya.webp" alt="A safari vehicle beside a river with hippos in the water" width="1000" height="750" loading="lazy" class="h-full w-full object-cover object-center transition duration-700 ease-out group-hover:scale-110" />
              <div class="absolute inset-0 bg-linear-to-t from-ink/50 via-transparent to-transparent"></div>
              <span class="glass-badge absolute left-3 top-3">East Africa</span>
              <span class="absolute bottom-3 right-3 flex h-9 w-9 items-center justify-center rounded-full border border-white/40 bg-white/15 text-white backdrop-blur transition group-hover:bg-white group-hover:text-royal-800">
                <Icon name="arrow-up-right" class="h-4 w-4" aria-hidden="true" />
              </span>
            </a>
            <div class="flex flex-1 flex-col p-5 sm:p-6">
              <h3 id="kenya-heading" class="font-display text-xl font-semibold"><a href="tours.html?destination=Kenya" class="transition hover:text-royal-700">Kenya</a></h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-500">Explore wildlife, landscapes and cultural experiences with an itinerary built around your time and interests.</p>
              <a href="tours.html?destination=Kenya" class="link-arrow mt-4">Explore Kenya
                <Icon name="arrow-right" class="h-4 w-4" aria-hidden="true" />
              </a>
            </div>
          </article>

          <article id="tanzania" data-destination-card data-region="east-africa" class="tour-card reveal group" aria-labelledby="tanzania-heading">
            <a href="tours.html?destination=Tanzania" class="relative block aspect-4/3 overflow-hidden" aria-label="View Tanzania tours and travel ideas">
              <img src="assets/img/optimized/tour-serengeti.webp" alt="A safari vehicle beneath a sunset sky in open grassland" width="1000" height="750" loading="lazy" class="h-full w-full object-cover object-center transition duration-700 ease-out group-hover:scale-110" />
              <div class="absolute inset-0 bg-linear-to-t from-ink/50 via-transparent to-transparent"></div>
              <span class="glass-badge absolute left-3 top-3">East Africa</span>
              <span class="absolute bottom-3 right-3 flex h-9 w-9 items-center justify-center rounded-full border border-white/40 bg-white/15 text-white backdrop-blur transition group-hover:bg-white group-hover:text-royal-800">
                <Icon name="arrow-up-right" class="h-4 w-4" aria-hidden="true" />
              </span>
            </a>
            <div class="flex flex-1 flex-col p-5 sm:p-6">
              <h3 id="tanzania-heading" class="font-display text-xl font-semibold"><a href="tours.html?destination=Tanzania" class="transition hover:text-royal-700">Tanzania</a></h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-500">Combine safari country, island time and city stops in a tailored East Africa journey.</p>
              <a href="tours.html?destination=Tanzania" class="link-arrow mt-4">Explore Tanzania
                <Icon name="arrow-right" class="h-4 w-4" aria-hidden="true" />
              </a>
            </div>
          </article>

          <article id="rwanda" data-destination-card data-region="east-africa" class="tour-card reveal group" aria-labelledby="rwanda-heading">
            <a href="tours.html?destination=Rwanda" class="relative block aspect-4/3 overflow-hidden" aria-label="View Rwanda tours and travel ideas">
              <img src="assets/img/optimized/tour-queen-elizabeth.webp" alt="A safari vehicle near a river with hippos in the distance" width="1000" height="667" loading="lazy" class="h-full w-full object-cover object-center transition duration-700 ease-out group-hover:scale-110" />
              <div class="absolute inset-0 bg-linear-to-t from-ink/50 via-transparent to-transparent"></div>
              <span class="glass-badge absolute left-3 top-3">East Africa</span>
              <span class="absolute bottom-3 right-3 flex h-9 w-9 items-center justify-center rounded-full border border-white/40 bg-white/15 text-white backdrop-blur transition group-hover:bg-white group-hover:text-royal-800">
                <Icon name="arrow-up-right" class="h-4 w-4" aria-hidden="true" />
              </span>
            </a>
            <div class="flex flex-1 flex-col p-5 sm:p-6">
              <h3 id="rwanda-heading" class="font-display text-xl font-semibold"><a href="tours.html?destination=Rwanda" class="transition hover:text-royal-700">Rwanda</a></h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-500">Ask about wildlife experiences, scenic routes and carefully paced travel in Rwanda.</p>
              <a href="tours.html?destination=Rwanda" class="link-arrow mt-4">Explore Rwanda
                <Icon name="arrow-right" class="h-4 w-4" aria-hidden="true" />
              </a>
            </div>
          </article>

          <article id="zanzibar" data-destination-card data-region="islands" class="tour-card reveal group" aria-labelledby="zanzibar-heading">
            <a href="tours.html?destination=Zanzibar" class="relative block aspect-4/3 overflow-hidden" aria-label="View Zanzibar tours and travel ideas">
              <img src="assets/img/optimized/tour-zanzibar.webp" alt="A lighthouse beside a white-sand beach and turquoise water" width="1000" height="563" loading="lazy" class="h-full w-full object-cover object-center transition duration-700 ease-out group-hover:scale-110" />
              <div class="absolute inset-0 bg-linear-to-t from-ink/50 via-transparent to-transparent"></div>
              <span class="glass-badge absolute left-3 top-3">Islands</span>
              <span class="absolute bottom-3 right-3 flex h-9 w-9 items-center justify-center rounded-full border border-white/40 bg-white/15 text-white backdrop-blur transition group-hover:bg-white group-hover:text-royal-800">
                <Icon name="arrow-up-right" class="h-4 w-4" aria-hidden="true" />
              </span>
            </a>
            <div class="flex flex-1 flex-col p-5 sm:p-6">
              <h3 id="zanzibar-heading" class="font-display text-xl font-semibold"><a href="tours.html?destination=Zanzibar" class="transition hover:text-royal-700">Zanzibar</a></h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-500">Pair time by the water with Stone Town, food and cultural experiences on a custom island itinerary.</p>
              <a href="tours.html?destination=Zanzibar" class="link-arrow mt-4">Explore Zanzibar
                <Icon name="arrow-right" class="h-4 w-4" aria-hidden="true" />
              </a>
            </div>
          </article>

          <article id="dubai" data-destination-card data-region="global" class="tour-card reveal group" aria-labelledby="dubai-heading">
            <a href="tours.html?destination=UAE" class="relative block aspect-4/3 overflow-hidden" aria-label="View Dubai tours and travel ideas">
              <img src="assets/img/optimized/style-global.webp" alt="The Dubai skyline and Burj Al Arab viewed across the water" width="900" height="579" loading="lazy" class="h-full w-full object-cover object-center transition duration-700 ease-out group-hover:scale-110" />
              <div class="absolute inset-0 bg-linear-to-t from-ink/50 via-transparent to-transparent"></div>
              <span class="glass-badge absolute left-3 top-3">Global</span>
              <span class="absolute bottom-3 right-3 flex h-9 w-9 items-center justify-center rounded-full border border-white/40 bg-white/15 text-white backdrop-blur transition group-hover:bg-white group-hover:text-royal-800">
                <Icon name="arrow-up-right" class="h-4 w-4" aria-hidden="true" />
              </span>
            </a>
            <div class="flex flex-1 flex-col p-5 sm:p-6">
              <h3 id="dubai-heading" class="font-display text-xl font-semibold"><a href="tours.html?destination=UAE" class="transition hover:text-royal-700">Dubai</a></h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-500">Plan a city break with skyline views, desert experiences and time to explore at your own pace.</p>
              <a href="tours.html?destination=UAE" class="link-arrow mt-4">Explore Dubai
                <Icon name="arrow-right" class="h-4 w-4" aria-hidden="true" />
              </a>
            </div>
          </article>

          <article id="south-africa" data-destination-card data-region="africa" class="tour-card reveal group" aria-labelledby="south-africa-heading">
            <a href="tours.html?destination=South%20Africa" class="relative block aspect-4/3 overflow-hidden" aria-label="View South Africa tours and travel ideas">
              <img src="assets/img/optimized/pkg-cape-town.webp" alt="Cape Town, Table Mountain and the Atlantic coastline viewed from above" width="1000" height="667" loading="lazy" class="h-full w-full object-cover object-center transition duration-700 ease-out group-hover:scale-110" />
              <div class="absolute inset-0 bg-linear-to-t from-ink/50 via-transparent to-transparent"></div>
              <span class="glass-badge absolute left-3 top-3">Africa</span>
              <span class="absolute bottom-3 right-3 flex h-9 w-9 items-center justify-center rounded-full border border-white/40 bg-white/15 text-white backdrop-blur transition group-hover:bg-white group-hover:text-royal-800">
                <Icon name="arrow-up-right" class="h-4 w-4" aria-hidden="true" />
              </span>
            </a>
