---
import Icon from "./Icon.astro";
---

<!-- Footer -->
<footer class="relative isolate overflow-hidden bg-royal-950 text-white">
  <div class="pointer-events-none absolute -left-32 top-0 h-96 w-96 rounded-full bg-royal-600/20 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -right-24 bottom-0 h-80 w-80 rounded-full bg-jade-500/10 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-0 dot-pattern opacity-[0.07]" aria-hidden="true"></div>

  <div class="container-x relative">
    <div class="grid gap-8 border-b border-white/10 py-12 lg:grid-cols-[1fr_0.9fr] lg:items-center lg:gap-16">
      <div>
        <p class="eyebrow eyebrow-light">The travel edit</p>
        <h2 class="mt-4 font-display text-2xl font-semibold tracking-tight text-white sm:text-3xl">Travel notes, not spam.</h2>
        <p class="mt-3 max-w-lg text-sm leading-relaxed text-white/70">Seasonal journeys and practical travel notes.</p>
      </div>
      <form data-newsletter class="w-full" novalidate>
        <label for="footer-email" class="sr-only">Email address</label>
        <div class="flex flex-col gap-2 rounded-2xl border border-white/15 bg-white/5 p-2 backdrop-blur sm:flex-row sm:items-center">
          <input id="footer-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" class="w-full rounded-xl border-0 bg-transparent px-4 py-3 text-sm text-white placeholder:text-white/65 focus:outline-none focus:ring-2 focus:ring-jade-400/60" required aria-describedby="newsletter-note" />
          <button type="submit" class="btn-green shrink-0 justify-center py-3 sm:px-5">
            Subscribe
            <Icon name="arrow-right" class="h-4 w-4" aria-hidden="true" />
          </button>
        </div>
        <p id="newsletter-note" data-newsletter-msg class="mt-2 text-xs leading-relaxed text-white/65" aria-live="polite">Opens your email app. No address is stored.</p>
      </form>
    </div>

    <div class="grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-[1.35fr_0.65fr_0.9fr_0.8fr_1.1fr] lg:gap-8">
      <div>
        <a href="index.html" class="inline-flex items-center rounded-2xl bg-white px-4 py-2" aria-label="Estnak Tours and Travel — home">
          <img src="assets/img/estnak%20logo.svg" alt="Estnak Tours and Travel" width="200" height="75" class="h-11 w-auto" loading="lazy" />
        </a>
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-white/70">Kampala-born. Africa-rooted. Private journeys, thoughtfully planned.</p>
        <div class="mt-6 flex flex-wrap gap-2" aria-label="Social links">
          <a href="https://www.instagram.com/estnaktoursandtravel" target="_blank" rel="noopener" class="social-link" aria-label="Estnak Tours and Travel on Instagram"><Icon name="instagram" class="h-4 w-4" aria-hidden="true" /></a>
          <a href="https://www.facebook.com/estnaktoursandtravel" target="_blank" rel="noopener" class="social-link" aria-label="Estnak Tours and Travel on Facebook"><Icon name="facebook" class="h-4 w-4" aria-hidden="true" /></a>
          <a href="https://x.com/estnaktoursandtravel" target="_blank" rel="noopener" class="social-link" aria-label="Estnak Tours and Travel on X"><Icon name="twitter" class="h-4 w-4" aria-hidden="true" /></a>
          <a href="https://www.youtube.com/@estnaktoursandtravel" target="_blank" rel="noopener" class="social-link" aria-label="Estnak Tours and Travel on YouTube"><Icon name="youtube" class="h-4 w-4" aria-hidden="true" /></a>
          <span class="social-link opacity-50" role="img" aria-label="LinkedIn profile coming soon" title="LinkedIn profile coming soon"><Icon name="linkedin" class="h-4 w-4" aria-hidden="true" /></span>
        </div>
      </div>

      <nav aria-labelledby="footer-explore">
        <h2 id="footer-explore" class="footer-heading">Explore</h2>
        <ul class="mt-4 space-y-2.5">
          <li><a href="index.html" class="footer-link">Home</a></li>
          <li><a href="destinations.html" class="footer-link">Services</a></li>
          <li><a href="tours.html" class="footer-link">Uganda &amp; Africa Safaris</a></li>
          <li><a href="tours.html?category=global" class="footer-link">Global Packages</a></li>
          <li><a href="about.html" class="footer-link">About Us</a></li>
          <li><a href="contact.html" class="footer-link">Contact</a></li>
        </ul>
      </nav>

      <nav aria-labelledby="footer-services">
        <h2 id="footer-services" class="footer-heading">Services</h2>
        <ul class="mt-4 space-y-2.5">
          <li><a href="destinations.html#tour-starter" class="footer-link">Flight booking</a></li>
          <li><a href="destinations.html#tour-starter" class="footer-link">Visa assistance</a></li>
          <li><a href="destinations.html#tour-starter" class="footer-link">Tours &amp; safaris</a></li>
          <li><a href="destinations.html#transport" class="footer-link">Transport &amp; rentals</a></li>
          <li><a href="destinations.html#tour-starter" class="footer-link">Accommodation</a></li>
          <li><a href="destinations.html#tour-starter" class="footer-link">Corporate travel</a></li>
        </ul>
      </nav>

      <nav aria-labelledby="footer-destinations">
        <h2 id="footer-destinations" class="footer-heading">Destinations</h2>
        <ul class="mt-4 space-y-2.5">
          <li><a href="destinations.html#uganda" class="footer-link">Uganda</a></li>
          <li><a href="destinations.html#kenya" class="footer-link">Kenya</a></li>
          <li><a href="destinations.html#tanzania" class="footer-link">Tanzania</a></li>
          <li><a href="destinations.html#rwanda" class="footer-link">Rwanda</a></li>
          <li><a href="tours.html?category=global" class="footer-link">Global packages</a></li>
        </ul>
      </nav>

      <div>
        <h2 class="footer-heading">Visit or call</h2>
        <ul class="mt-4 space-y-3.5">
          <li class="flex items-start gap-3">
            <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-white/5 text-jade-300"><Icon name="map-pin" class="h-4 w-4" aria-hidden="true" /></span>
            <span class="text-sm leading-relaxed text-white/70">Civic Centre, Christ The King<br />217507 Kampala GPO, Uganda</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-white/5 text-jade-300"><Icon name="phone" class="h-4 w-4" aria-hidden="true" /></span>
            <span class="flex flex-col gap-1 text-sm leading-relaxed text-white/70"><a href="tel:+256769532299" class="inline-flex min-h-6 items-center transition hover:text-white">0769 532299</a><a href="https://wa.me/256769532299" target="_blank" rel="noopener" class="inline-flex min-h-6 items-center transition hover:text-white">WhatsApp us</a></span>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-white/5 text-jade-300"><Icon name="mail" class="h-4 w-4" aria-hidden="true" /></span>
            <span class="text-sm leading-relaxed text-white/70"><a href="mailto:estnaktoursandtravel@gmail.com" class="inline-flex min-h-6 items-center transition hover:text-white">estnaktoursandtravel@gmail.com</a></span>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-white/5 text-jade-300"><Icon name="clock-3" class="h-4 w-4" aria-hidden="true" /></span>
            <span class="text-sm leading-relaxed text-white/70">Mon–Sat, 9:00 AM–5:00 PM EAT<br /><span class="text-white/60">Sunday closed</span></span>
          </li>
        </ul>
        <a href="contact.html#map" class="link-arrow mt-5 text-jade-300 hover:text-jade-200">Open in Google Maps <Icon name="arrow-up-right" class="h-4 w-4" aria-hidden="true" /></a>
      </div>
    </div>

    <div class="flex flex-col gap-4 border-t border-white/10 py-6 text-xs text-white/65 sm:flex-row sm:items-center sm:justify-between">
      <p>© <span data-year>2026</span> Estnak Tours and Travel. All rights reserved. <span class="hidden sm:inline">·</span> <span class="block sm:inline">Crafted in Kampala, Uganda.</span></p>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <a href="sitemap.xml" class="transition hover:text-white">Sitemap</a>
        <a href="contact.html#privacy" class="transition hover:text-white">Privacy note</a>
        <button type="button" data-back-to-top class="inline-flex items-center gap-1.5 transition hover:text-white">Back to top <Icon name="arrow-up" class="h-3.5 w-3.5" aria-hidden="true" /></button>
      </div>
    </div>
  </div>
</footer>

<!-- Floating WhatsApp -->
<aside aria-label="Quick contact" class="fixed bottom-5 right-5 z-40 sm:bottom-7 sm:right-7">
  <a href="https://wa.me/256769532299?text=Hello%20Estnak%20Tours%20and%20Travel%2C%20I%27d%20like%20help%20planning%20a%20trip." target="_blank" rel="noopener" class="whatsapp-pulse inline-flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-float transition duration-300 hover:-translate-y-1 hover:bg-[#1ebe5b] focus-visible:ring-4 focus-visible:ring-jade-300/60" aria-label="Chat with Estnak Tours and Travel on WhatsApp">
    <Icon name="message-circle" class="h-7 w-7" aria-hidden="true" />
    <span class="sr-only">Chat on WhatsApp</span>
  </a>
</aside>
