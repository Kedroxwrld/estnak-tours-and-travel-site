---
import { iconLibrary } from "../data/icons";

interface Props {
  name: string;
  class?: string;
  [key: string]: string | number | boolean | undefined;
}

const { name, class: className, ...attrs } = Astro.props;
const iconName = name.replace(/(\w)(\w*)(_|-|\s*)/g, (_match, first: string, rest: string) =>
  first.toUpperCase() + rest.toLowerCase()
);
const iconNode = iconLibrary[iconName];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  {...attrs}
>
  {iconNode?.[2]?.map(([tag, attrs]) => {
    const Tag = tag;
    return <Tag {...attrs} />;
  })}
</svg>
